{
  "builders": [
    {
      "use_default_display": "{{user `headless`}}",
      "boot_command": [
        "<wait1m30s>",
        "installer<enter>",
        "opnsense<enter><wait>",
        "<enter><wait2s>",
        "<enter><wait2s>",
        "<down><enter><wait2s>",
        "<left><enter><wait2s>",
        "<wait5m>",
        "<down><enter><wait>",
        "<wait1m30s>",
        "root<enter>",
        "opnsense<enter><wait>",
        "8<enter><wait2s>",
        "dhclient vtnet0<enter><wait5s>",
        "telnet {{ .HTTPIP }} {{ .HTTPPort }} | sed '1,/^$/d' >/conf/config.xml<wait><enter>",
        "GET /config.xml HTTP/1.0<enter><enter>",
        "reboot<enter>"
      ],
      "boot_wait": "{{user `boot_wait`}}",
      "disk_interface": "virtio-scsi",
      "disk_size": "{{ user `disk_size` }}",
      "format": "raw",
      "headless": "{{user `headless`}}",
      "http_directory": "{{user `http_directory`}}",
      "http_port_max": "{{user `http_port_max`}}",
      "http_port_min": "{{user `http_port_min`}}",
      "iso_checksum": "{{user `iso_checksum`}}",
      "iso_url": "{{user `iso_url`}}",
      "name": "qemu",
      "net_device": "virtio-net",
      "output_directory": "target-qemu",
      "qemuargs": [
        [ "-m", "{{ user `memory_size` }}m" ],
        [ "-smp", "cpus={{ user `cpus` }},maxcpus=16,cores=4" ]
      ],
      "shutdown_command": "{{user `shutdown_command`}}",
      "ssh_password": "{{user `ssh_password`}}",
      "ssh_port": "{{user `ssh_port`}}",
      "ssh_username": "{{user `ssh_username`}}",
      "ssh_wait_timeout": "{{user `ssh_wait_timeout`}}",
      "type": "qemu",
      "vm_name": "{{user `vm_name`}}",
      "vnc_bind_address": "{{user `vnc_vrdp_bind_address`}}",
      "vnc_port_min": "{{user `vnc_vrdp_port`}}",
      "vnc_port_max": "{{user `vnc_vrdp_port`}}"
    }
  ],
  "provisioners": [
    {
      "type": "file",
      "source": "cloud.cfg",
      "destination": "/tmp/cloud.cfg"
	},
    {
      "scripts": [
        "scripts/cloud-init.sh"
      ],
      "type": "shell",
      "only": ["qemu"],
      "execute_command": "chmod +x {{ .Path }}; /bin/sh -c '{{ .Vars }} {{ .Path }}'"
    },
    {
      "scripts": [
        "scripts/disable-root-password.sh"
      ],
      "type": "shell",
      "execute_command": "chmod +x {{ .Path }}; /bin/sh -c '{{ .Vars }} {{ .Path }}'"
    }
  ],
  "variables": {
    "boot_wait": "2s",
    "cpus": "4",
    "disk_size": "8192",
    "headless": "true",
    "guest_os_type": "FreeBSD_64",
    "http_directory": "http",
    "http_port_max": "10089",
    "http_port_min": "10082",
    "iso_checksum": "ada52df0ef2119c77a833aab48ea212323900502f42735fb115e07c4e4c71ac3",
    "iso_url": "./opnsense.iso",
    "memory_size": "4096",
    "shutdown_command": "shutdown -p now",
    "ssh_password": "opnsense",
    "ssh_port": "22",
    "ssh_username": "root",
    "ssh_wait_timeout": "5m",
    "vm_name": "opnsense",
    "vnc_vrdp_bind_address": "127.0.0.1",
    "vnc_vrdp_port": "5900"
  }
}
